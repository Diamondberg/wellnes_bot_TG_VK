# ============================================================
#  WELLNESS BOT — конфигурация
#  Скопируй этот файл в .env и заполни значения
# ============================================================

# ─── Telegram ──────────────────────────────────────────────
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
ADMIN_ID=123456789

# ─── База данных (PostgreSQL) ──────────────────────────────
# Формат: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
# Локально:
DATABASE_URL=postgresql+asyncpg://postgres:postgres123@localhost:5432/wellness_bot

# ─── Email уведомления (опционально) ───────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your.email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_TO=admin@example.com

# ─── Прокси (опционально, для запуска бота из РФ) ──────────
# Формат: http://user:pass@host:port
PROXY_URL=

# ============================================================
#  АРЕНДАТОР (Tenant) — параметры конкретного клиента/себя
#  Сейчас один арендатор = один .env-файл.
#  Когда дойдём до SaaS — это переедет в БД.
# ============================================================

# Уникальный код арендатора (латиница, без пробелов)
# Используется как идентификатор в БД
TENANT_CODE=default

# Название юрлица/ИП арендатора (для политики конфиденциальности)
TENANT_NAME=ИП Иванов И.И.

# ИНН арендатора
TENANT_INN=000000000000

# Контакт арендатора в Telegram (для политики, без @)
TENANT_CONTACT_TG=Diamondberg

# Email арендатора для запросов по 152-ФЗ
TENANT_CONTACT_EMAIL=kondratenko.pro@gmail.com

# Ссылка на полную политику конфиденциальности (на сайте/в канале)
TENANT_PRIVACY_URL=https://t.me/zdorovyakov/24

# Условия реферальной программы (URL)
TENANT_REFERRAL_TERMS_URL=https://t.me/zdorovyakov/24
